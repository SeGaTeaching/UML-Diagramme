@startuml
!include /sessions/amazing-cool-carson/mnt/07_UML-Diagramme/diagramm-quellen/theme.puml
state Neu
state Bezahlt
state NichtVerifiziert
state Aktiv

Neu --> Bezahlt : bezahlen() / Rechnung erstellen
NichtVerifiziert --> Aktiv : registrieren() / Bestätigungs-E-Mail senden
Aktiv --> Aktiv : login() [Passwort falsch] / Fehlversuch-Zähler erhöhen
@enduml