@startuml
!include /sessions/amazing-cool-carson/mnt/07_UML-Diagramme/diagramm-quellen/theme.puml
left to right direction

actor Nutzer
actor Bibliothekar
actor "Bezahlsystem" as Bezahlsystem

rectangle "Bibliothekssystem" {
  usecase "Buch ausleihen" as UC1
  usecase "Buch zurückgeben" as UC2
  usecase "Buch suchen" as UC3
  usecase "Buch hinzufügen" as UC4
  usecase "Buch entfernen" as UC5
  usecase "Mahnung verschicken" as UC6
}

Nutzer --> UC1
Nutzer --> UC2
Nutzer --> UC3

Bibliothekar --> UC1
Bibliothekar --> UC2
Bibliothekar --> UC3
Bibliothekar --> UC4
Bibliothekar --> UC5
Bibliothekar --> UC6

UC6 --> Bezahlsystem : kommuniziert mit
@enduml
