@startuml
!include /sessions/amazing-cool-carson/mnt/07_UML-Diagramme/diagramm-quellen/theme.puml
' Optimiert die Darstellung für Entscheidungen
!pragma useVerticalIf on

skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ActivityBackgroundColor #E3F2FD
skinparam ActivityBorderColor #1976D2
skinparam ActivityFontColor #0D47A1
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #FBC02D

start

repeat
  :Passwort eingeben;

  ' Erste Prüfung: Ist das Passwort korrekt?
  if (Passwort korrekt?) then ([ja])
    :Zugang gewährt;
    stop
  
  ' Wenn nein: Haben wir noch Versuche?
  elseif (Versuche >= 3?) then ([ja])
    :Zugang verweigert;
    stop
    
  else ([nein])
    ' Hier landen wir nur, wenn Passwort falsch UND Versuche < 3 sind.
    ' Der Pfad läuft einfach weiter zur Schleifen-Rückführung.
  endif

' Die Bedingung für den Rücksprung steht direkt am Pfeil
repeat while ([Passwort falsch, Versuche < 3])

@enduml