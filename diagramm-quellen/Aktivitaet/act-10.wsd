@startuml
!include /sessions/amazing-cool-carson/mnt/07_UML-Diagramme/diagramm-quellen/theme.puml
' Wichtig für saubere vertikale Layouts
!pragma useVerticalIf on

skinparam ActivityStartColor black
skinparam ActivityEndColor black
skinparam ActivityBackgroundColor white
skinparam ActivityBorderColor #1976D2
skinparam ActivityFontColor #0D47A1
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #FBC02D
skinparam ActivityBarColor black

' --- DEFINITION DER SCHWIMMBAHNEN ---
' Wir definieren die Farben direkt im Header der Bahn

|#e3f2fd|Kunde|
start
:Artikel auswählen;
:Zur Kasse gehen;

|#fff3e0|Webshop|
:Verfügbarkeit prüfen;

' --- ENTSCHEIDUNG 1: Verfügbarkeit ---
if (Verfügbar?) then ([nicht verfügbar])
  :Bestellung abbrechen\n(nicht verfügbar);
  stop
else ([verfügbar])
  ' Wir wechseln zurück zum Kunden für die Zahlung
  |#e3f2fd|Kunde|
  :Zahlung durchführen;
endif

' --- ENTSCHEIDUNG 2: Zahlung ---
' Zurück zum Webshop zur Prüfung
|#fff3e0|Webshop|

if (Zahlung OK?) then ([fehlgeschlagen])
  :Bestellung abbrechen\n(Zahlung fehlgeschlagen);
  stop
else ([erfolgreich])
  :Bestellung bestätigen;
endif

' --- PARALLELE VERARBEITUNG IM LAGER ---
|#f3e5f5|Lager|
fork
  :Artikel kommissionieren;
fork again
  :Paket packen;
end fork

' --- VERSAND ---
|#e8f5e9|Versand|
:Paket abholen;
:Paket zustellen;

stop
@enduml